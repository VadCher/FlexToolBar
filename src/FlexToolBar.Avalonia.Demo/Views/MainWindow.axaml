<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlexToolBar.Avalonia.Demo.ViewModels"
        xmlns:ftb="clr-namespace:FlexToolBar.Avalonia;assembly=FlexToolBar.Avalonia"
        x:Class="FlexToolBar.Avalonia.Demo.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FlexToolBar Demonstration App"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- CUSTOMIZATION LESSON: How to make TabStrip headers tight and compact -->
        <Style Selector="ftb|ToolBar TabStripItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <!-- CUSTOMIZATION LESSON: Ensuring all groups match the highest content dynamically -->
        <Style Selector="ftb|Tab">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ftb|FlexGroup">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Bottom control panel for demo interactivity -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="10" BorderThickness="1,0,0,0" BorderBrush="LightGray">
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                
                <!-- Zero code: bound TwoWay to ViewModel state -->
                <CheckBox Content="Enable IsSingleExpandGroup" 
                          IsChecked="{Binding IsSingleExpandMode, Mode=TwoWay}"/>
                
                <!-- Zero code: executes the embedded library command directly by element name -->
                <Button Content="Reset Layout (To Defaults)" 
                        Command="{Binding #DemoToolBar.ResetLayoutCommand}"
                        Padding="10,5" Background="LightGray"/>
            </StackPanel>
        </Border>

        <!-- TEST: Turning the demo into a pure minimalist "anti-desktop" by default -->
        <!-- Fixed: Restored x:Name for XAML compiler Element-Name Binding resolution -->
        <ftb:ToolBar x:Name="DemoToolBar"
                     AutoSaveId="DemoWorkspaceLayout" 
                     DockPanel.Dock="Top" 
                     IsSingleExpandGroup="True">
            <ftb:ToolBar.Tabs>
                
                <!-- Tab 1: Home Workspace -->
                <ftb:Tab Header="Home" ftb:Tab.TabId="HomeTab">
                    <ftb:Tab.Items>
                        
                        <!-- File Group: Statically pinned, non-collapsible container -->
                        <ftb:FlexGroup Header="File" IsPinned="True" PinVisible="False" ftb:FlexGroup.GroupId="FileGroup">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                                <Button Content="FileMenu" />
                                <Button Content="QuickSave" Width="80"/>
                            </StackPanel>
                        </ftb:FlexGroup>

                        <!-- Font Group: Starts collapsed by default -->
                        <ftb:FlexGroup Header="Font" ExpandedHeader="Font Parameters" IsExpanded="False" ftb:FlexGroup.GroupId="FontGroup">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                                <ToggleButton Content="B" FontWeight="Bold" Width="30"/>
                                <ToggleButton Content="I" FontStyle="Italic" Width="30"/>
                            </StackPanel>
                        </ftb:FlexGroup>

                        <!-- Tools Group: Starts collapsed by default -->
                        <ftb:FlexGroup Header="Tools" ExpandedHeader="Utility Tools" IsExpanded="False" ftb:FlexGroup.GroupId="ToolsGroup">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                                <Button Content="Zoom In"/>
                                <Button Content="Zoom Out"/>
                            </StackPanel>
                        </ftb:FlexGroup>
                        
                    </ftb:Tab.Items>
                </ftb:Tab>
                
            </ftb:ToolBar.Tabs>
        </ftb:ToolBar>

        <!-- Main interactive content rendering viewport area -->
        <Grid Background="White">
            <TextBlock Text="Main Workspace Content Area" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="16" Foreground="Gray"/>
        </Grid>
    </DockPanel>
</Window>
