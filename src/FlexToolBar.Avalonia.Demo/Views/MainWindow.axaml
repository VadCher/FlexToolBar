<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlexToolBar.Avalonia.Demo.ViewModels"
        xmlns:ftb="clr-namespace:FlexToolBar.Avalonia;assembly=FlexToolBar.Avalonia"
        x:Class="FlexToolBar.Avalonia.Demo.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FlexToolBar Demonstration App"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Bottom control panel for demo interactivity -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="10" BorderThickness="1,0,0,0" BorderBrush="LightGray">
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                <CheckBox Content="Enable IsSingleExpandGroup" 
                          IsChecked="{Binding IsSingleExpandMode, Mode=TwoWay}"/>
                <Button Content="Reset Layout (To Defaults)" 
                        Command="{Binding ResetDemoLayoutCommand}"
                        Padding="10,5" Background="LightGray"/>
            </StackPanel>
        </Border>

        <!-- Root hybrid toolbar instance configured via declarative XAML markup -->
        <ftb:ToolBar DockPanel.Dock="Top" IsSingleExpandGroup="{Binding IsSingleExpandMode}">
            <ftb:ToolBar.Tabs>
                
                <!-- Tab 1: Home Workspace -->
                <ftb:Tab Header="Home" ftb:Tab.TabId="HomeTab">
                    <ftb:Tab.Items>
                        
                        <!-- File Group: Statically pinned, non-collapsible container -->
                        <ftb:FlexGroup Header="File" IsPinned="True" PinVisible="False" ftb:FlexGroup.GroupId="FileGroup">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                                <Button Content="FileMenu">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="New Project"/>
                                            <MenuItem Header="Open File..."/>
                                            <Separator/>
                                            <MenuItem Header="Save Layout"/>
                                            <MenuItem Header="Exit"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="QuickSave" Width="80"/>
                            </StackPanel>
                        </ftb:FlexGroup>

                        <!-- Font Group: Dynamic layout group with header fallback -->
                        <ftb:FlexGroup Header="Font" ExpandedHeader="Font Parameters" ftb:FlexGroup.GroupId="FontGroup">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                                <ToggleButton Content="B" FontWeight="Bold" Width="30"/>
                                <ToggleButton Content="I" FontStyle="Italic" Width="30"/>
                                <ComboBox SelectedIndex="0" Width="120">
                                    <ComboBoxItem>Arial</ComboBoxItem>
                                    <ComboBoxItem>Times New Roman</ComboBoxItem>
                                    <ComboBoxItem>Segoe UI</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ftb:FlexGroup>

                        <!-- Tools Group: Second dynamic group to fully test IsSingleExpandGroup behavior -->
                        <ftb:FlexGroup Header="Tools" ExpandedHeader="Utility Tools" ftb:FlexGroup.GroupId="ToolsGroup">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4">
                                <Button Content="Zoom In"/>
                                <Button Content="Zoom Out"/>
                                <Button Content="Reset Zoom"/>
                            </StackPanel>
                        </ftb:FlexGroup>
                        
                    </ftb:Tab.Items>
                </ftb:Tab>

                <!-- Tab 2: View Configurations -->
                <ftb:Tab Header="View" ftb:Tab.TabId="ViewTab">
                    <ftb:Tab.Items>
                        <ftb:FlexGroup Header="Layout" ftb:FlexGroup.GroupId="LayoutGroup">
                            <UniformGrid Rows="1" Margin="4">
                                <RadioButton Content="Grid View" IsChecked="True" Margin="0,0,10,0"/>
                                <RadioButton Content="List View"/>
                            </UniformGrid>
                        </ftb:FlexGroup>
                    </ftb:Tab.Items>
                </ftb:Tab>
                
            </ftb:ToolBar.Tabs>
        </ftb:ToolBar>

        <!-- Main interactive content rendering viewport area -->
        <Grid Background="White">
            <TextBlock Text="Main Workspace Content Area" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="16" Foreground="Gray"/>
        </Grid>
    </DockPanel>
</Window>
