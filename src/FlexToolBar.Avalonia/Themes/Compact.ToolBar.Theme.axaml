<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ftb="clr-namespace:FlexToolBar.Avalonia">

    <!-- COMPACTblueprints: Targets components via flat cascading selectors without keys -->
    <Style Selector="ftb|ToolBar">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector=":is(ftb|FlexGroup)">
        <Setter Property="Padding" Value="2,1,2,1"/>
        <Setter Property="Background" Value="#FFCBF816"/>
    </Style>

    <Style Selector="ftb|FlexButton">
        <Setter Property="Padding" Value="2"/>
    </Style>
    <Style Selector="TabStrip#PART_TabSelectionStrip">
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabStrip#PART_TabSelectionStrip TabStripItem">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Blue"/>
    </Style>

</Styles>
