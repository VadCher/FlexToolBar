<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ftb="clr-namespace:FlexToolBar.Avalonia">

    <!-- Современная тема элемента управления ToolBar для Avalonia 11/12 -->
    <ControlTheme x:Key="{x:Type ftb:ToolBar}" TargetType="ftb:ToolBar">

        <!-- Сеттеры базовых свойств по умолчанию -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>

        <!-- Главный шаблон управления -->
        <Setter Property="Template">
            <ControlTemplate>
                <!-- GLOBAL MONOLITHIC CONTROLLER: Root layout wrapper container -->
                <Border x:Name="PART_RootContainer"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch">

                    <!-- TWO-ROW OUTER GRID: Separates headers and active workspaces completely -->
                    <Grid RowDefinitions="Auto,*">

                        <!-- ROW 0: TAB STRIP HEADERS BORDER FRAME -->
                        <TabStrip x:Name="PART_TabSelectionStrip" Grid.Row="0"
                                  ItemsSource="{TemplateBinding Tabs}"
                                  SelectedValueBinding="{Binding (ftb:Tab.TabId)}"
                                  SelectedValue="{Binding ViewModel.SelectedTabId, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  IsVisible="{Binding IsTabHeaderVisible, RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- <TabStrip.Styles>
                                <Style Selector="TabStripItem">
                                    <Setter Property="MinHeight" Value="20"/>
                                </Style>
                            </TabStrip.Styles> -->
                            <TabStrip.ItemTemplate>
                                <DataTemplate x:DataType="ftb:Tab">
                                    <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </TabStrip.ItemTemplate>
                        </TabStrip>

                        <!-- ROW 1: ACTIVE RIBBON CONTENT BORDER FRAME -->
                        <Border x:Name="PART_ContentContainer"
                                Grid.Row="1"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch">

                            <!-- Pure single-row, 7-column layout engine -->
                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- 0: Fixed Left Edge Padding -->
                                    <ColumnDefinition Width="Auto"/> <!-- 1: Left Arrow Button -->
                                    <ColumnDefinition Width="Auto"/> <!-- 2: Dynamic Inner Left Gap -->
                                    <ColumnDefinition Width="*"/>    <!-- 3: Core ScrollViewer Content Box -->
                                    <ColumnDefinition Width="Auto"/> <!-- 4: Dynamic Inner Right Gap -->
                                    <ColumnDefinition Width="Auto"/> <!-- 5: Right Arrow Button -->
                                </Grid.ColumnDefinitions>

                                <!-- [Col 0]: Fixed Left app margin linked to inherited spacing property -->
                                <Border Grid.Column="0"
                                        Width="{Binding (ftb:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}"/>

                                <!-- [Col 1]: Left Scroll Action Button -->
                                <Button x:Name="PART_ScrollLeftButton"
                                        Grid.Column="1"
                                        Content="{TemplateBinding ScrollLeftContent}"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsVisible="False"/>

                                <!-- [Col 2]: Inner Left Gap - collapses to 0 when arrow is hidden -->
                                <Border Grid.Column="2"
                                        Width="{Binding (ftb:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}"
                                        IsVisible="{Binding #PART_ScrollLeftButton.IsVisible}"/>

                                <!-- [Col 3]: Global Scroll Viewport carrying active presenters -->
                                <ScrollViewer x:Name="PART_TabScrollViewer"
                                              Grid.Column="3"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Stretch">
                                    <ContentPresenter x:Name="PART_ActiveContentPresenter"
                                                      Content="{Binding SelectedItem, ElementName=PART_TabSelectionStrip}"
                                                      VerticalAlignment="Stretch"/>
                                </ScrollViewer>

                                <!-- [Col 4]: Inner Right Gap - collapses to 0 when arrow is hidden -->
                                <Border Grid.Column="4"
                                        Width="{Binding (ftb:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}"
                                        IsVisible="{Binding #PART_ScrollRightButton.IsVisible}"/>

                                <!-- [Col 5]: Right Scroll Action Button -->
                                <Button x:Name="PART_ScrollRightButton"
                                        Grid.Column="5"
                                        Content="{TemplateBinding ScrollRightContent}"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- <Style Selector="^ /template/ Border#PART_HeaderContainer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,2,4,0"/>
        </Style> -->

        <Style Selector="^ /template/ Border#PART_ContentContainer">
            <!-- <Setter Property="Background" Value=""/> -->
            <!-- <Setter Property="BorderBrush" Value="#DCDCDC"/> -->
            <!-- <Setter Property="BorderThickness" Value="0,1,0,1"/> -->
            <Setter Property="Padding" Value="0,4,0,4"/>
        </Style>

        <Style Selector="^ /template/ Button#PART_ScrollLeftButton, ^ /template/ Button#PART_ScrollRightButton">
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

    </ControlTheme>

</ResourceDictionary>
