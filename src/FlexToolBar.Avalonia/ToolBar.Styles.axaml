<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlexToolBar.Avalonia">
    
    <Style Selector="local|ToolBar">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 2-Row, 7-Column Master Grid by Vadim's Blueprint -->
                <Grid RowDefinitions="Auto,*" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 0: Fixed Left Edge Padding -->
                        <ColumnDefinition Width="Auto"/> <!-- 1: Left Arrow Button & Tab Headers anchor -->
                        <ColumnDefinition Width="Auto"/> <!-- 2: Dynamic Inner Left Gap -->
                        <ColumnDefinition Width="*"/>    <!-- 3: Main Content Box Framework -->
                        <ColumnDefinition Width="Auto"/> <!-- 4: Dynamic Inner Right Gap -->
                        <ColumnDefinition Width="Auto"/> <!-- 5: Right Arrow Button -->
                        <ColumnDefinition Width="Auto"/> <!-- 6: Fixed Right Edge Padding -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- ================================================================= -->
                    <!-- ROW 0: TAB STRIP HEADERS PANEL                                    -->
                    <!-- Seated directly in Col 1 to stay aligned with the scroll layout   -->
                    <!-- ================================================================= -->
                    <TabStrip x:Name="PART_TabSelectionStrip"
                              Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="6"
                              ItemsSource="{TemplateBinding Tabs}"
                              IsVisible="{Binding IsTabHeaderVisible, RelativeSource={RelativeSource TemplatedParent}}"
                              Padding="0"
                              Margin="0"
                              Background="Transparent">
                        <TabStrip.ItemTemplate>
                            <DataTemplate x:DataType="local:Tab">
                                <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </TabStrip.ItemTemplate>
                    </TabStrip>
                    
                    <!-- ================================================================= -->
                    <!-- ROW 1: ACTIVE RIBBON CONTENT & TOUCH NAVIGATION CONTROLS          -->
                    <!-- ================================================================= -->
                    
                    <!-- [Row 1, Col 0]: Fixed Left app margin linked to inherited spacing property -->
                    <Border Grid.Row="1" Grid.Column="0" 
                            Width="{Binding (local:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}"/>

                    <!-- [Row 1, Col 1]: Left Scroll Action Button (Width is now dynamic Auto-size) -->
                    <Button x:Name="PART_ScrollLeftButton"
                            Grid.Row="1" Grid.Column="1"
                            Content="{TemplateBinding ScrollLeftContent}"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsVisible="False"/>

                    <!-- [Row 1, Col 2]: Inner Left Gap - collapses to 0 when arrow is hidden -->
                    <Border Grid.Row="1" Grid.Column="2" 
                            Width="{Binding (local:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}" 
                            IsVisible="{Binding #PART_ScrollLeftButton.IsVisible}"/>

                    <!-- [Row 1, Col 3]: Global Scroll Viewport carrying active presenters -->
                    <ScrollViewer x:Name="PART_TabScrollViewer"
                                  Grid.Row="1" Grid.Column="3"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Stretch">
                        <ContentPresenter x:Name="PART_ActiveContentPresenter"
                                          Content="{Binding SelectedItem, ElementName=PART_TabSelectionStrip}"
                                          VerticalAlignment="Stretch"/>
                    </ScrollViewer>
                    
                    <!-- [Row 1, Col 4]: Inner Right Gap - collapses to 0 when arrow is hidden -->
                    <Border Grid.Row="1" Grid.Column="4" 
                            Width="{Binding (local:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}" 
                            IsVisible="{Binding #PART_ScrollRightButton.IsVisible}"/>

                    <!-- [Row 1, Col 5]: Right Scroll Action Button (Width is now dynamic Auto-size) -->
                    <Button x:Name="PART_ScrollRightButton"
                            Grid.Row="1" Grid.Column="5"
                            Content="{TemplateBinding ScrollRightContent}"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsVisible="False"/>

                    <!-- [Row 1, Col 6]: Fixed Right app margin linked to inherited spacing property -->
                    <Border Grid.Row="1" Grid.Column="6" 
                            Width="{Binding (local:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- CORE DEFAULT STYLING FOR NAVIGATION BUTTONS                       -->
    <!-- Out-of-the-box settings that can be seamlessly overridden by themes -->
    <!-- ================================================================= -->
    <Style Selector="local|ToolBar Button#PART_ScrollLeftButton, local|ToolBar Button#PART_ScrollRightButton">
        <!-- Default core padding instead of inline hardcode -->
        <Setter Property="Padding" Value="4,0,4,0"/>
        <Setter Property="Background" Value="#F9F9F9"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>

</Styles>
