<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlexToolBar.Avalonia">
    
    <Style Selector="local|Tab">
        <!-- Forces child FlexGroups to align horizontally using our inherited attached property -->
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{Binding (local:ToolBar.GroupSpacing), RelativeSource={RelativeSource TemplatedParent}}"/>
            </ItemsPanelTemplate>
        </Setter>
        
        <Setter Property="Template">
            <ControlTemplate>
                <!-- CLEAN CORE SKELETON: Tab remains a naked content carrier. -->
                <ItemsPresenter x:Name="PART_ItemsPresenter" 
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                VerticalAlignment="Stretch"/>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
